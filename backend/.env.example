NODE_ENV=development
PORT=5000
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# OpenAI-compatible chat completions API (Gemini, OpenAI, OpenRouter, Groq, ...)
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-1.5-flash
AI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash-8b

# Administrator (teacher) account. Created or updated automatically on every server start.
ADMIN_LOGIN=
ADMIN_PASSWORD=
